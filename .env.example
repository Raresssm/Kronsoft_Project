# Docker Compose (Postgres + Keycloak)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agora_campus
POSTGRES_PORT=5432

KEYCLOAK_PORT=8090
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Gmail SMTP for Keycloak forgot-password emails (dev only — use a Google App Password)
# https://myaccount.google.com/apppasswords
KEYCLOAK_SMTP_HOST=smtp.gmail.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_USER=your.name@gmail.com
KEYCLOAK_SMTP_PASSWORD=your-16-char-app-password
KEYCLOAK_SMTP_FROM=your.name@gmail.com
KEYCLOAK_SMTP_FROM_DISPLAY_NAME="Agora Campus"

# Spring Boot overrides (optional; defaults work with ./scripts/dev/dev-up.sh)
DB_URL=jdbc:postgresql://localhost:5432/agora_campus
DB_USERNAME=postgres
DB_PASSWORD=postgres
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/agora-campus
KEYCLOAK_SERVER_URL=http://localhost:8090
KEYCLOAK_REALM=agora-campus
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
